{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tasks", "snapshots", "risks"],
  "properties": {
    "summary": { "type": "string" },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "files", "steps", "verify_cmd", "estimate_min"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "items": { "type": "string" } },
          "verify_cmd": { "type": "string" },
          "estimate_min": { "type": "integer", "minimum": 1, "maximum": 30 }
        }
      }
    },
    "snapshots": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "login"],
        "properties": { "path": { "type": "string" }, "login": { "type": "boolean" } }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
